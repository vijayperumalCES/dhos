# Copy to .env.local. Values below are the well-known defaults printed by `supabase start`
# for the LOCAL stack (API on port 55321). Replace with your hosted project's values in
# production — see docs/DEPLOYMENT.md.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_ACJWlzQHlZjBrEguHvfOxg_3BJgxAaH
# Production: https://stride-ces.vercel.app
NEXT_PUBLIC_SITE_URL=http://localhost:3100

# Server-only. Used by the e2e test harness to create throwaway users and, since Phase 7, by the
# automation worker (see below). Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# Server-only. Optional: AI agents work without it on the built-in rule-based provider. Set it to
# let an organization choose the Anthropic provider in AI Agents -> Settings.
ANTHROPIC_API_KEY=

# Server-only. Required for automation (Phase 7): the background worker and the "Process now" and
# "Sync now" buttons call service_role RPCs with SUPABASE_SECRET_KEY (above). CRON_SECRET (16+ random
# characters) protects /api/cron/tick, which a scheduler must call about once a minute.
CRON_SECRET=

# Server-only. Optional: with both set, notification email is sent through Resend; without them it is
# recorded as "simulated".
RESEND_API_KEY=
EMAIL_FROM=
